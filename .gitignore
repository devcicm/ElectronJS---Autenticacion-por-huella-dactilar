**/*.dll.tmp
**/*.pdb

# Windows specific
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msix
*.msm
*.msp

# Artifacts de redirección mal hecha en PowerShell (> nul)
nul
_nul

# Base de datos local (runtime, nunca versionar)
*.db
*.db-journal
*.db-wal
*.db-shm

# Artefactos TS compilados junto a su fuente (solo sistema-asistencia/database)
sistema-asistencia/database/init.js
sistema-asistencia/database/init.d.ts

# System files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Icon?

# Temporary files
*.tmp
*.temp
*~
*.swp
*.swo

# Logs and debugging
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE specific
*.sublime-project
*.sublime-workspace
.idea/

# Testing
coverage/
.nyc_output/
test-results/

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Build outputs (keep clean)
*.js.map
*.d.ts.map

# Archive directory - Keep only essential DLLs
archive/**/bin/
archive/**/obj/
archive/**/.vs/
archive/**/*.pdb
archive/**/*.exe
archive/**/*.deps.json
archive/**/*.runtimeconfig.json

# Specific to DigitalPersona - Keep only native DLLs
# Essential native DLLs for builds
!archive/**/DPURUNET/DPUruNet.dll
!archive/**/DPURUNET/dpfj.dll
!archive/**/DPURUNET/dpfpdd.dll
!archive/**/DPURUNET/DPCtlUruNet.dll
!dotnet/Dp4500Net8Bridge/libs/*.dll

# Prevent compiled archive DLLs
archive/**/*.dll
# But allow the essential native ones above

# Package managers
package-lock.json.backup
yarn.lock.backup

# Runtime generated files
electron-builder-output/
release-builds/

# End of .gitignore